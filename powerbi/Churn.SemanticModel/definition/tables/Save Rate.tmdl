table 'Save Rate'

	measure 'Save Rate Value' = SELECTEDVALUE('Save Rate'[Save Rate], 0.1)
		formatString: 0%

	column 'Save Rate'
		dataType: double
		formatString: 0%
		summarizeBy: none
		sourceColumn: [Value]

	partition 'Save Rate' = calculated
		mode: import
		source = GENERATESERIES(0.05, 0.5, 0.05)
